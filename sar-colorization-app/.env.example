# Optional Google Gemini AI analysis. Keep all values server-side; never use NEXT_PUBLIC_GEMINI_API_KEY.
GEMINI_DEFAULT_MODEL=gemini-3.5-flash
GEMINI_SUPPORTED_MODELS=gemini-3.5-flash,gemini-3.6-flash
# Deployment-owned key only; local users configure their own key in Settings → AI Providers.
GEMINI_API_KEY=replace_with_a_server_side_key
GEMINI_MODEL=gemini-3.5-flash
# Reserved for encrypted server-side secret-store deployments; do not commit it.
GEOVISION_SECRET_ENCRYPTION_KEY=replace_with_a_high_entropy_secret
